---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}{{ site.baseurl }}/"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  {% assign meetings = site.pages | where_exp: "p", "p.path contains 'meetings/20'" | sort: "date" | reverse %}
  {% for m in meetings limit: 10 %}
  <entry>
    <title>{% include meeting-title.html p=m %}</title>
    <link href="{{ site.url }}{{ site.baseurl }}{{ m.url }}"/>
    <id>{{ site.url }}{{ site.baseurl }}{{ m.url }}</id>
    <updated>{{ m.date | date_to_xmlschema }}</updated>
    <content type="html">{{ m.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
